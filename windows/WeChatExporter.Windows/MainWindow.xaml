<Window x:Class="WeChatExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信聊天记录导出"
        Width="980" Height="680" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="16">
            <Border DockPanel.Dock="Top" Background="#F5F5F5" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="48" Height="48">
                            <TextBlock Text="💬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="导出工具" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="选择联系人后导出 TXT / CSV / JSON" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowOperationProgress, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding OperationProgress, Mode=OneWay}"
                                     Height="8" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding OperationProgressLabel}" FontSize="11" Foreground="Gray"/>
                        <TextBlock Text="{Binding OperationProgressPercentText}" FontSize="10"
                                   Foreground="Gray" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 Visibility="{Binding ShowIndeterminateBusy, Converter={StaticResource BoolToVis}}"
                                 Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="准备数据" Padding="10,6" Margin="0,0,6,0"
                        Click="PrepareData_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"/>
                <Button Content="刷新" Padding="10,6" Margin="0,0,6,0"
                        Click="Refresh_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"/>
                <Button Content="导出选中" Padding="10,6"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        Click="Export_Click" IsEnabled="{Binding CanExport}"/>
                <!-- #39：长任务进行中显示「取消」按钮（窗口不再冻结成未响应，用户可随时中止） -->
                <Button Content="取消" Padding="10,6" Margin="6,0,0,0" Foreground="Gray"
                        Click="Cancel_Click"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6"/>

            <TextBlock DockPanel.Dock="Top" Text="{Binding FilteredCountText}" Foreground="Gray" Margin="0,0,0,6"/>

            <ListBox x:Name="ContactList"
                     ItemsSource="{Binding ContactsView}"
                     SelectionMode="Extended"
                     SelectionChanged="ContactList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="10"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#F5F5F5" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding ReadinessHint}" TextWrapping="Wrap" Foreground="#444"/>
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding OperationProgress, Mode=OneWay}"
                                     Height="8" Margin="0,10,0,0"
                                     Visibility="{Binding ShowOperationProgress, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="以管理员身份重新启动" Margin="0,10,0,0" Padding="10,6"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource AdminVis}}"
                                Click="RestartAdmin_Click"/>
                    </StackPanel>
                </Border>

                <GroupBox Header="导出设置" Margin="0,0,0,16" Padding="12">
                    <StackPanel>
                        <CheckBox Content="同时导出图片、表情、全部表情包等媒体并内嵌到 HTML（体积更大）"
                                  IsChecked="{Binding IncludeMedia}"/>
                        <CheckBox Content="导出媒体时本地离线转写语音（whisper.cpp，缺少工具自动跳过）"
                                  IsChecked="{Binding VoiceTranscriptionEnabled}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding VoiceTranscriptStatus}" Foreground="Gray" FontSize="11"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Button Content="下载 whisper 模型"
                                Click="DownloadWhisperModel_Click" Padding="10,4" Margin="0,6,0,0"
                                HorizontalAlignment="Left"/>
                        <CheckBox Content="导出媒体时对图片做本地离线文字识别（OCR）"
                                  IsChecked="{Binding OcrEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="导出时生成聊天统计报告（消息量/时段/排行）"
                                  IsChecked="{Binding StatsReportEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="增量导出：只导出上次之后的新增消息（按联系人+目录记忆游标）"
                                  IsChecked="{Binding IncrementalExportEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="导出后生成目录导航页 index.html（文件列表 + 全文检索框）"
                                  IsChecked="{Binding IndexPageEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="导出时生成 EPUB 电子书（本地阅读 App 可打开）"
                                  IsChecked="{Binding EbookEpubEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="导出时生成文档版（A4 打印版，浏览器可打印/另存 PDF）"
                                  IsChecked="{Binding EbookDocumentEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="在导出产物上平铺视觉水印（关闭即无水印版本）"
                                  IsChecked="{Binding WatermarkEnabled}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="水印文字（默认：林琝淏科技集团有限公司）"
                                 FontSize="12" Margin="0,6,0,0"/>
                        <TextBlock Text="HTML 产物（单文件 / 统计 / 目录 / 表情包画廊）会平铺斜纹水印；EPUB 加版权页脚；文档版（打印版 HTML）平铺深色水印。关闭开关后导出全部无水印。"
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Separator Margin="0,10,0,6"/>
                        <TextBlock Text="v2.19 新功能" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <CheckBox Content="生成全文搜索索引 wce-search.sqlite（搜索面板 / wce CLI 用）"
                                  IsChecked="{Binding SearchIndexEnabled}" Margin="0,6,0,0"/>
                        <CheckBox Content="生成年度可视化报告（年度报告_年份.html）"
                                  IsChecked="{Binding AnnualReportEnabled}" Margin="0,6,0,0"/>
                        <CheckBox Content="提取日历事件（日历事件.ics / 日历事件.json）"
                                  IsChecked="{Binding CalendarExtractEnabled}" Margin="0,6,0,0"/>
                        <CheckBox Content="脱敏导出：名称代号化（用户A/B/…）+ 可选 PII 模糊化"
                                  IsChecked="{Binding AnonEnabled}" Margin="0,6,0,0"/>
                        <CheckBox Content="　└ 同时模糊化手机号/身份证/邮箱（138****5678 形）"
                                  IsChecked="{Binding AnonMaskPii}" Margin="0,2,0,0" IsEnabled="{Binding AnonEnabled}"/>
                        <CheckBox Content="　└ 保留映射文件 anonymization-map.json（取消则导出后销毁，不可逆）"
                                  IsChecked="{Binding AnonKeepMapping}" Margin="0,2,0,0" IsEnabled="{Binding AnonEnabled}"/>
                        <CheckBox Content="过滤导出：时间区间 + 关键词（过滤先于脱敏/索引/报告）"
                                  IsChecked="{Binding FilterEnabled}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding FilterEnabled}">
                            <TextBlock Text="起" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                            <TextBox Text="{Binding FilterFromDate, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Margin="4,0,8,0" FontSize="12" ToolTip="起始日期 yyyy-MM-dd（含，空=不限）"/>
                            <TextBlock Text="止" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                            <TextBox Text="{Binding FilterToDate, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Margin="4,0,8,0" FontSize="12" ToolTip="结束日期 yyyy-MM-dd（含，空=不限）"/>
                        </StackPanel>
                        <TextBox Text="{Binding FilterKeywords, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,0" FontSize="12"
                                 ToolTip="过滤关键词（逗号分隔，不区分大小写；空=不过滤内容）"/>
                        <CheckBox Content="报错时自动上传诊断日志"
                                  IsChecked="{Binding DiagnosticsConsented}" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="全文搜索（v2.19）" Margin="0,0,0,16" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300" Padding="6,4" ToolTip="搜索最近一次导出目录的 wce-search.sqlite 索引"/>
                            <Button Content="搜索" Padding="10,4" Margin="8,0,0,0" Click="Search_Click"/>
                            <Button Content="重建索引" Padding="10,4" Margin="8,0,0,0" Click="RebuildIndex_Click"/>
                        </StackPanel>
                        <TextBlock Text="搜索上次导出的全部会话（FTS5 全文检索）；双击结果打开对应会话的 chat.txt。"
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchHits}"
                                 MaxHeight="180" Margin="0,8,0,0" MouseDoubleClick="SearchResultsList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding TimeText}" Foreground="Gray"/><Run Text="  "/>
                                            <Run Text="{Binding Chat}" FontWeight="SemiBold"/><Run Text=" · "/>
                                            <Run Text="{Binding Sender}" Foreground="#07C35F"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Snippet}" Foreground="Gray" FontSize="11"
                                                   TextWrapping="Wrap" MaxHeight="40"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="定时增量导出（v2.19）" Margin="0,0,0,16" Padding="12">
                    <StackPanel>
                        <CheckBox Content="启用定时增量导出（无人值守，每 N 分钟同步新增消息）"
                                  IsChecked="{Binding AutoSyncEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="间隔（分钟，≥5）：" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                            <TextBox Text="{Binding AutoSyncIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="安装定时任务" Padding="10,6" Margin="0,0,8,0" Click="InstallAutoSync_Click"/>
                            <Button Content="卸载定时任务" Padding="10,6" Click="UninstallAutoSync_Click"/>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap">
                            <Run Text="状态："/><Run Text="{Binding AutoSyncInstalled, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="　·　上次运行："/><Run Text="{Binding AutoSyncLastRun, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="用 Windows 计划任务（schtasks）每 N 分钟运行一次 wce --auto-sync；只导出新增，无新增静默结束。日志：%LocalAppData%/WCE/autosync.log。"
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="加密导出" Margin="0,0,0,16" Padding="12">
                    <StackPanel>
                        <PasswordBox x:Name="PwdBox" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="设置导出密码" Padding="10,6" Margin="0,0,8,0"
                                    Click="SetPassword_Click"/>
                            <Button Content="解密导出…" Padding="10,6"
                                    Click="DecryptExport_Click"/>
                        </StackPanel>
                        <TextBlock Text="设置密码后，导出目录将整体加密为单个 .wxenc 文件（AES-256-GCM + PBKDF2-SHA256），并自动删除明文目录。密码只在内存中持有，不落盘。留空则按普通明文目录导出；.wxenc 可复制到任意机器用同密码解密（双端互通）。"
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="导出目录" Margin="0,0,0,16" Padding="12">
                    <StackPanel>
                        <TextBox Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="选择…" Padding="10,6" Margin="0,0,8,0" Click="ChooseFolder_Click"/>
                            <Button Content="打开" Padding="10,6" Click="OpenFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="使用说明" Margin="0,0,0,16" Padding="12">
                    <StackPanel>
                        <TextBlock Text="1. 首次使用点击「准备数据」（需微信 PC 版已登录）" Margin="0,2"/>
                        <TextBlock Text="2. 若密钥扫描失败，请右键以管理员身份运行本程序" Margin="0,2"/>
                        <TextBlock Text="3. 在左侧列表中选择一个或多个联系人（Ctrl 多选）" Margin="0,2"/>
                        <TextBlock Text="4. 点击「导出选中」" Margin="0,2"/>
                        <TextBlock Text="5. 默认导出目录：Downloads\微信聊天记录导出\" Foreground="Gray" Margin="0,2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="日志" Padding="12">
                    <DockPanel MinHeight="280">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="Gray"
                                   HorizontalAlignment="Right" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Logs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
